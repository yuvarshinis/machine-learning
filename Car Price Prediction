from sklearn.linear_model import LinearRegression

# Dataset: Age and Price (in lakhs)
X = [[1], [2], [3], [4], [5]]
y = [10, 8, 6, 4, 2]

# Train model
model = LinearRegression()
model.fit(X, y)

# Predict price for a 3-year-old car
prediction = model.predict([[3]])

print("Predicted Car Price:", prediction[0], "Lakhs")



output
Predicted Car Price: 6.0 Lakhs
